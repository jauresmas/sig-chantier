# Modèle de 05_mapstore/.env (ignoré par git). 00_creer_base.py le copie et remplit le mot de passe.

# Dossier de la pile MapStore (docker-compose.yml et son .env avec les comptes admin), barres « / »
MAPSTORE_PILE=D:/mapstore

# Rôle PostgreSQL « sig_chantier » (base sig_chantier), tiré au hasard par 00_creer_base.py
SIG_CHANTIER_DB_PASSWORD=

# Facultatifs, détectés sinon
# PILE_URL=http://localhost:8097
# QGIS_DIR=C:/Program Files/QGIS 3.34.12
# PSQL=C:/Program Files/PostgreSQL/15/bin/psql.exe
